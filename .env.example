# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Site
# Bruges til canonical-URLs, sitemap og OG-billeder.
NEXT_PUBLIC_SITE_URL=https://skoenhedsklinik-aarhus.dk

# ---------------------------------------------------------------------------
# Meta (Facebook) — annoncemåling
# ---------------------------------------------------------------------------
# Pixel ID fra Meta Events Manager (15-16 cifre).
# Pixlen aktiveres først når denne er sat (tom = ingen pixel indlæses).
# Samme ID skal også indsættes i Planway under Apps > Facebook Pixel.
NEXT_PUBLIC_META_PIXEL_ID=

# Conversions API-token: Events Manager > din pixel > Indstillinger >
# "Konverterings-API" > Generér adgangstoken. Uden token sendes der intet
# server-side, og siden fungerer uændret.
META_CAPI_ACCESS_TOKEN=

# Valgfri: testkode fra Events Manager > Testhændelser. Sæt den, mens du
# validerer opsætningen, og FJERN den igen bagefter — ellers tæller
# hændelserne ikke med i de rigtige kampagnedata.
META_TEST_EVENT_CODE=

# Valgfri: Graph API-version til Conversions API. Standard er v23.0.
META_GRAPH_API_VERSION=

# ---------------------------------------------------------------------------
# Google-anmeldelser (Places API New)
# ---------------------------------------------------------------------------
# Server-side API-nøgle med "Places API (New)" aktiveret i Google Cloud.
# Begræns nøglen til Places API (New) under "API restrictions".
GOOGLE_PLACES_API_KEY=

# Klinikkens Place ID (starter med ChIJ...). Findes via Google Place ID Finder.
# Uden begge variabler viser siden generiske klientudtalelser i stedet.
GOOGLE_PLACE_ID=

# ---------------------------------------------------------------------------
# Planway
# ---------------------------------------------------------------------------
# Valgfri: klinikkens bookingside ("Direkte link" under Indstillinger >
# Online booking > Bookingside). Tom = standardlinket i src/lib/booking.ts.
NEXT_PUBLIC_PLANWAY_BOOKING_URL=

# Valgfri: fast DKK-værdi på en gennemført booking, når behandlingen ikke har
# en pris i prislisten. Er den tom, sendes Schedule-hændelsen uden værdi.
# Bruges kun som fallback: normalt bruges laveste listepris for behandlingen.
BOOKING_DEFAULT_VALUE_DKK=

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------
# Plausible-domæne, f.eks. skoenhedsklinik-aarhus.dk. Tom = intet script.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Telefonkonsultation (booking-guiden på forsiden) ---
# Leads gemmes i Supabase-tabellen `consultation_leads` (se add_consultation_leads.sql)
# og vises under Admin → Henvendelser. Ingen ekstra miljøvariabler kræves.
